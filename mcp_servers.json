{
  "_comment": "MCP Server 统一配置（Claude Desktop 兼容格式）。所有 MCP server 统一管理，不区分内置/外部。env/args 支持 ${VAR} 占位符；占位变量缺失时会跳过该 server。以 '_' 开头的 key 为禁用项。",
  "mcpServers": {
    "eduagent": {
      "command": "python",
      "args": ["/app/app/tools/server.py"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "_disabled_filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/app/uploads"]
    },
    "_disabled_fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    }
  }
}
