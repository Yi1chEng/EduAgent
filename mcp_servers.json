{
  "_comment": "外部 MCP Server 配置（Claude Desktop 兼容格式）。env/args 支持 ${VAR} 占位符，从 backend/.env 读取；占位变量缺失时会跳过该 server。以 '_' 开头的 key 为禁用项。",
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "_disabled_filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/app/uploads"]
    },
    "_disabled_fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    }
  }
}
