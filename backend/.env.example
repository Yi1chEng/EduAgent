# LLM（推荐 ModelScope Qwen3-30B-A3B：免费 + 30B MoE，教育问答又快又准）
# 备选：Qwen/Qwen3-235B-A22B（质量更高但慢 5-10 倍） / Qwen/Qwen3-8B（最快但质量弱）
LLM_API_KEY=ms-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api-inference.modelscope.cn/v1
LLM_MODEL_NAME=Qwen/Qwen3-30B-A3B-Instruct-2507

# Embedding（推荐 SiliconFlow + bge-m3，1024 维与 db_models.py 匹配）
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxx
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# 数据库（docker-compose 启动 postgres 时自动覆盖为容器内地址）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eduagent

# 工具：企业微信 Webhook（用于 send_wechat MCP 工具）
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
